module

public import Mathlib.Algebra.MvPolynomial.PDeriv
public import Mathlib.RingTheory.Ideal.Quotient.Defs
public import Mathlib.RingTheory.Ideal.Span
public import Mathlib.RingTheory.MvPolynomial.Homogeneous

/-!
# Jacobian Ideal, Jacobian Ring, and Euler's Homogeneous Identity

This file defines the Jacobian ideal `MvPolynomial.jacobianIdeal f` and the Jacobian
quotient ring `MvPolynomial.JacobianRing f`, establishes Euler's identity for homogeneous
multivariate polynomials (`euler_homogeneous_eq`), and computes the Jacobian ideal of the
Fermat diagonal hypersurface `fermatPoly σ R m = ∑ i : σ, X i ^ m`.

## Main definitions and results

* `MvPolynomial.jacobianIdeal`: the ideal generated by all partial derivatives `pderiv i f`.
* `MvPolynomial.JacobianRing`: the quotient ring `MvPolynomial σ R ⧸ jacobianIdeal f`.
* `MvPolynomial.euler_homogeneous_eq`: `∑ i : σ, X i * pderiv i f = (d : MvPolynomial σ R) * f`.
* `MvPolynomial.jacobianIdeal_fermatPoly_of_isUnit`: when `(m : R)` is a unit,
  `jacobianIdeal (fermatPoly σ R m) = Ideal.span (Set.range fun i => X i ^ (m - 1))`.
-/

@[expose] public section

namespace MvPolynomial

open Finsupp

variable {σ : Type*} {R : Type*} [CommSemiring R]

/-- The Jacobian ideal of a multivariate polynomial `f : MvPolynomial σ R`, generated by all
partial derivatives `pderiv i f`. -/
noncomputable def jacobianIdeal (f : MvPolynomial σ R) : Ideal (MvPolynomial σ R) :=
  Ideal.span (Set.range fun i : σ => pderiv i f)

/-- The Jacobian ring `R[X] / J(f)` of a multivariate polynomial `f`. -/
abbrev JacobianRing {σ : Type*} {R : Type*} [CommRing R] (f : MvPolynomial σ R) :=
  MvPolynomial σ R ⧸ jacobianIdeal f

theorem pderiv_mem_jacobianIdeal (f : MvPolynomial σ R) (i : σ) :
    pderiv i f ∈ jacobianIdeal f :=
  Ideal.subset_span ⟨i, rfl⟩

/-- **Euler's homogeneous function theorem**: for any homogeneous multivariate polynomial `f`
of total degree `d` over a finite variable type `σ`, `∑ i, X i * ∂f/∂X_i = d * f`. -/
theorem euler_homogeneous_eq [Fintype σ] {f : MvPolynomial σ R} {d : ℕ}
    (hf : f.IsHomogeneous d) :
    ∑ i : σ, X i * pderiv i f = (d : MvPolynomial σ R) * f := by
  conv_lhs =>
    rw [← f.support_sum_monomial_coeff]
  simp_rw [map_sum, Finset.mul_sum]
  rw [Finset.sum_comm]
  have hterm : ∀ s ∈ f.support,
      (∑ i : σ, X i * pderiv i (monomial s (f.coeff s))) =
        (d : MvPolynomial σ R) * monomial s (f.coeff s) := by
    intro s hs
    simp_rw [X_mul_pderiv_monomial, nsmul_eq_mul, ← Finset.sum_mul, ← Nat.cast_sum]
    have hsum : ∑ i : σ, s i = ∑ i ∈ s.support, s i :=
      (Finset.sum_subset (Finset.subset_univ s.support) fun i _ hi =>
        Finsupp.notMem_support_iff.mp hi).symm
    rw [hsum, ← hf.degree_eq_sum_deg_support hs]
  rw [Finset.sum_congr rfl hterm, ← Finset.mul_sum, f.support_sum_monomial_coeff]

/-- For a homogeneous polynomial `f` of degree `d`, `(d : MvPolynomial σ R) * f` lies in
`jacobianIdeal f`. -/
theorem natCast_mul_mem_jacobianIdeal_of_isHomogeneous [Fintype σ]
    {f : MvPolynomial σ R} {d : ℕ} (hf : f.IsHomogeneous d) :
    (d : MvPolynomial σ R) * f ∈ jacobianIdeal f := by
  rw [← euler_homogeneous_eq hf]
  exact Ideal.sum_mem _ fun i _ => Ideal.mul_mem_left _ (X i) (pderiv_mem_jacobianIdeal f i)

section Fermat

variable (σ R)

/-- The Fermat diagonal hypersurface polynomial `∑ i : σ, X i ^ m`. -/
noncomputable def fermatPoly [Fintype σ] (m : ℕ) : MvPolynomial σ R :=
  ∑ i : σ, (X i : MvPolynomial σ R) ^ m

variable {σ R}

theorem isHomogeneous_fermatPoly [Fintype σ] (m : ℕ) :
    (fermatPoly σ R m).IsHomogeneous m :=
  IsHomogeneous.sum _ _ _ fun i _ => isHomogeneous_X_pow i m

@[simp]
theorem pderiv_fermatPoly [Fintype σ] [DecidableEq σ] (m : ℕ) (i : σ) :
    pderiv i (fermatPoly σ R m) = (m : MvPolynomial σ R) * X i ^ (m - 1) := by
  unfold fermatPoly
  rw [map_sum]
  refine (Finset.sum_eq_single i (fun j _ hj => ?_) (fun hi => ?_)).trans ?_
  · rw [pderiv_pow, pderiv_X_of_ne hj, mul_zero]
  · exact (hi (Finset.mem_univ i)).elim
  · rw [pderiv_pow, pderiv_X_self, mul_one]

theorem jacobianIdeal_fermatPoly [Fintype σ] [DecidableEq σ] (m : ℕ) :
    jacobianIdeal (fermatPoly σ R m) =
      Ideal.span (Set.range fun i : σ => (m : MvPolynomial σ R) * X i ^ (m - 1)) := by
  unfold jacobianIdeal
  congr 1
  ext p
  simp [pderiv_fermatPoly]

/-- When `(m : R)` is a unit in `R`, the Jacobian ideal of `∑ i, X_i ^ m` equals
`Ideal.span (Set.range fun i => X i ^ (m - 1))`. -/
theorem jacobianIdeal_fermatPoly_of_isUnit [Fintype σ] [DecidableEq σ] {m : ℕ}
    (hm : IsUnit (m : R)) :
    jacobianIdeal (fermatPoly σ R m) =
      Ideal.span (Set.range fun i : σ => (X i : MvPolynomial σ R) ^ (m - 1)) := by
  rw [jacobianIdeal_fermatPoly]
  have hu : IsUnit ((m : MvPolynomial σ R)) := by
    rw [← map_natCast (C : R →+* MvPolynomial σ R)]
    exact hm.map C
  refine le_antisymm ?_ ?_
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    exact Ideal.mul_mem_left _ _ (Ideal.subset_span ⟨i, rfl⟩)
  · refine Ideal.span_le.mpr ?_
    rintro _ ⟨i, rfl⟩
    obtain ⟨u, hu_eq⟩ := hu
    have hmem : (m : MvPolynomial σ R) * X i ^ (m - 1) ∈
        Ideal.span (Set.range fun j : σ => (m : MvPolynomial σ R) * X j ^ (m - 1)) :=
      Ideal.subset_span ⟨i, rfl⟩
    have hmul := Ideal.mul_mem_left _ (↑u⁻¹ : MvPolynomial σ R) hmem
    have hcancel : (↑u⁻¹ : MvPolynomial σ R) * ((m : MvPolynomial σ R) * X i ^ (m - 1)) =
        X i ^ (m - 1) := by
      rw [← hu_eq, ← mul_assoc, u.inv_mul, one_mul]
    rwa [hcancel] at hmul

end Fermat

end MvPolynomial
